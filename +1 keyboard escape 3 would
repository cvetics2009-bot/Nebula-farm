-- ===== ЛОГИКА ФАРМА =====
local function SetNoClip(state)
    if state then
        if not noClipConnection then
            noClipConnection = RunService.Stepped:Connect(function()
                local char = LocalPlayer.Character
                if char then
                    for _, part in pairs(char:GetDescendants()) do
                        if part:IsA("BasePart") and part.CanCollide then
                            part.CanCollide = false
                        end
                    end
                end
            end)
        end
    else
        if noClipConnection then
            noClipConnection:Disconnect()
            noClipConnection = nil
        end
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            char.HumanoidRootPart.CanCollide = true
        end
    end
end

local function FreezeCharacter()
    local char = LocalPlayer.Character
    if not char then return end
    
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    
    if hrp then
        for _, v in pairs(hrp:GetChildren()) do
            if v:IsA("BodyVelocity") or v:IsA("BodyPosition") or v:IsA("BodyGyro") or v:IsA("BodyThrust") then
                v:Destroy()
            end
        end
    end
    
    if torso then
        for _, v in pairs(torso:GetChildren()) do
            if v:IsA("BodyVelocity") or v:IsA("BodyPosition") or v:IsA("BodyGyro") or v:IsA("BodyThrust") then
                v:Destroy()
            end
        end
    end
    
    if hum then
        hum.WalkSpeed = 0
        hum.JumpPower = 0
        hum.PlatformStand = true
        hum.AutoRotate = false
    end
    
    if hrp then
        hrp.Anchored = true
    end
    
    isFrozen = true
end

local function UnfreezeCharacter()
    local char = LocalPlayer.Character
    if not char then return end
    
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    
    if hrp then
        hrp.Anchored = false
    end
    
    if hum then
        hum.WalkSpeed = 16
        hum.JumpPower = 50
        hum.PlatformStand = false
        hum.AutoRotate = true
    end
    
    isFrozen = false
end

local function FlyTo(targetPos, isLast)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return false end
    
    local hrp = char.HumanoidRootPart
    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    bv.Parent = hrp
    
    local reached = false
    local attempts = 0
    
    while autoFarm and not reached and attempts < 400 do
        if not char or not char:FindFirstChild("HumanoidRootPart") then break end
        
        local distance = (hrp.Position - targetPos).Magnitude
        
        if distance < 50 and distance > 10 and attempts > 10 then
            local prevDistance = distance
            task.wait(0.05)
            local newDistance = (hrp.Position - targetPos).Magnitude
            if newDistance > prevDistance then
                hrp.CFrame = CFrame.new(targetPos)
                reached = true
                break
            end
        end
        
        if distance <= 6 then
            reached = true
            break
        else
            local direction = (targetPos - hrp.Position).Unit
            bv.Velocity = direction * currentSpeed
        end
        
        attempts = attempts + 1
        task.wait(0.015)
    end
    
    pcall(function() bv:Destroy() end)
    
    if reached and isLast then
        hrp.CFrame = CFrame.new(targetPos)
        task.wait(0.05)
        FreezeCharacter()
        task.wait(0.1)
        UnfreezeCharacter()
        return true
    end
    
    if not reached and isLast then
        hrp.CFrame = CFrame.new(targetPos)
        task.wait(0.05)
        FreezeCharacter()
        task.wait(0.1)
        UnfreezeCharacter()
        return true
    end
    
    return reached
end

local function DeleteObstacles()
    local obs = {"LavaPart","Lava_Stage3","MovingWall","DoorWall1","GreenDoorKillPart",
        "RedDoorKillPart","YellowDoorKillPart","DoorWall2","DoorWall3",
        "Stage2LocalNPC_Local","Tumbleweed","vanilla","EyesLaser",
        "Stage11LocalNPC_Local","Stage14LocalNPC_Local"}
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj and obj.Parent then
            for _, name in ipairs(obs) do
                if obj.Name == name then pcall(function() obj:Destroy() end) break end
            end
            if obj.Name:match("^MovingWall%d+$") then pcall(function() obj:Destroy() end) end
        end
    end
end

local function StartFarm()
    autoFarm = true
    n.Text = "⏹ СТОП"
    n.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    m.Text = "🔄 Фарм запущен..."
    m.TextColor3 = Color3.fromRGB(0, 255, 100)
    
    task.spawn(function()
        while autoFarm do
            local waypoints = Routes[currentRoute]
            if not waypoints or #waypoints == 0 then break end
            
            SetNoClip(true)
            
            for i, point in ipairs(waypoints) do
                if not autoFarm then break end
                local isLast = (i == #waypoints)
                FlyTo(point, isLast)
            end
            
            task.wait(0.1)
        end
        
        SetNoClip(false)
        if isFrozen then
            UnfreezeCharacter()
        end
        n.Text = "▶ СТАРТ"
        n.BackgroundColor3 = Color3.fromRGB(0, 200, 80)
        m.Text = "⏸ Фарм остановлен"
        m.TextColor3 = Color3.fromRGB(255, 200, 100)
    end)
end

n.MouseButton1Click:Connect(function()
    if autoFarm then
        autoFarm = false
        n.Text = "▶ СТАРТ"
        n.BackgroundColor3 = Color3.fromRGB(0, 200, 80)
        m.Text = "⏸ Фарм остановлен"
        m.TextColor3 = Color3.fromRGB(255, 200, 100)
        SetNoClip(false)
        if isFrozen then
            UnfreezeCharacter()
        end
    else
        StartFarm()
    end
end)

