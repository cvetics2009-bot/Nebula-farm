local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer.PlayerGui

-- Создаем таблицу для быстрого поиска
local ValueLookup = {}
for name, val in pairs(Values) do
    ValueLookup[name:lower()] = val
end

local function CreateValueLabel(parent, value)
    local label = Instance.new("TextLabel")
    label.Name = "MM2Value"
    label.Size = UDim2.new(1, 0, 0, 16)
    label.Position = UDim2.new(0, 0, -0.3, 0)
    label.BackgroundTransparency = 0.5
    label.BackgroundColor3 = Color3.new(0, 0, 0)
    label.TextColor3 = Color3.new(1, 0.8, 0)
    label.TextScaled = true
    label.Font = Enum.Font.GothamBold
    
    if value == "Priceless" then
        label.Text = "⭐ Бесценно"
        label.TextColor3 = Color3.new(1, 0, 0)
    else
        label.Text = "⭐ " .. value
    end
    
    label.ZIndex = 999
    label.BorderSizePixel = 0
    label.Parent = parent
    return label
end

local function FindWeaponInText(text)
    if not text or text == "" then return nil end
    
    local lowerText = text:lower()
    
    -- Сначала точное совпадение
    if ValueLookup[lowerText] then
        return ValueLookup[lowerText]
    end
    
    -- Потом частичное (для длинных названий)
    if #lowerText > 4 then
        for weaponName, value in pairs(ValueLookup) do
            if lowerText:find(weaponName, 1, true) then
                return value
            end
        end
    end
    
    return nil
end

local function ScanTrade()
    -- 1. УДАЛЯЕМ ВСЕ СТАРЫЕ МЕТКИ
    for _, obj in ipairs(PlayerGui:GetDescendants()) do
        if obj.Name == "MM2Value" then
            obj:Destroy()
        end
    end
    
    -- 2. ИЩЕМ ВСЕ ТЕКСТОВЫЕ МЕТКИ
    local labels = PlayerGui:GetDescendants()
    
    for _, obj in ipairs(labels) do
        if obj:IsA("TextLabel") then
            local text = obj.Text or ""
            
            if #text >= 3 then
                local value = FindWeaponInText(text)
                
                if value then
                    local parent = obj.Parent
                    if parent then
                        -- Создаем новую метку
                        CreateValueLabel(parent, value)
                    end
                end
            end
        end
    end
end

-- Запускаем сканирование КАЖДЫЙ РАЗ заново
while wait(0.3) do
    pcall(ScanTrade)
end
