local function teleportFunc()
    if st.tp or st.dl or not hrp or not st.en then return end
    st.dl=true
    q("⏳ Телепорт...")
    task.wait(coords.del)
    if hrp and (hrp.Position-coords.tar).Magnitude<=coords.rad then
        if st.en then
            hrp.Position=coords.tel
            st.tp=true
            q("✅ УСПЕШНО!")
        end
    else
        q("❌ Отменен")
    end
    st.dl=false
    task.wait(2)
    st.tp=false
    if st.en then q("⏳ Ожидание...") else q("⛔ Выключен") end
end

local function checkPos()
    if not hrp or st.tp or st.dl or not st.en then return end
    if(hrp.Position-coords.tar).Magnitude<=coords.rad then teleportFunc() end
end

game:GetService("RunService").Heartbeat:Connect(checkPos)

